# ── TinaCMS Cloud credentials ────────────────────────────────────────────────
# Leave both empty for local development: `npm run dev` edits the files on
# your machine directly, no account needed.
#
# For the live site, create a project at https://app.tina.io, connect this
# GitHub repo, then copy the values from the project's "Overview" page.

# Client ID (safe to expose; it is embedded in the /admin JavaScript)
TINA_PUBLIC_CLIENT_ID=

# Read-only content token (keep secret; used at build time only)
TINA_TOKEN=

# Branch TinaCloud should read and write. Keep this in sync with the branch
# connected in the TinaCloud project.
TINA_PUBLIC_BRANCH=main

# Optional local override. Vercel and Netlify are detected automatically.
# DEPLOY_TARGET=vercel
# DEPLOY_TARGET=netlify

# Publication gate. Keep `staging` on the Netlify foundation so every page is
# noindex and sitemap.xml remains empty. Change to `release` only for the
# authorized custom-domain launch. Use SITE_ORIGIN (not SITE_URL) for overrides.
SITE_MODE=staging
# SITE_ORIGIN=https://itsakeeperphotography.netlify.app

# Contact calculator audit metadata. Keep this aligned with the recipient
# configured in Netlify → Forms → Form notifications for `session-estimate`.
# Switch to itsakeeperphoto@gmail.com after testing is approved.
PUBLIC_INQUIRY_NOTIFICATION_EMAIL=globalbridge360@gmail.com

# Google Business Profile review-summary refresh (server-side Netlify secrets).
# These values must never use a PUBLIC_ prefix or be committed with credentials.
# The Google account must own or manage the verified location and authorize the
# `business.manage` OAuth scope. IDs may be supplied bare or as accounts/... and
# locations/... resource names.
GBP_OAUTH_CLIENT_ID=
GBP_OAUTH_CLIENT_SECRET=
GBP_OAUTH_REFRESH_TOKEN=
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=
