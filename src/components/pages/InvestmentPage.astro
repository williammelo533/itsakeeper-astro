---
import type {
  EditorialPageData,
  PageSection,
} from "../../content/page-types";
import { absoluteUrl, siteOrigin } from "../../lib/site-environment";
import Picture from "../Picture.astro";
import EditorialHero from "./EditorialHero.astro";
import "../../styles/investment-page.css";

interface Props {
  page: EditorialPageData;
  settings: any;
  inquiry?: any;
}

const { page } = Astro.props;

const requireSection = (id: string): PageSection => {
  const section = page.sections.find((candidate) => candidate.id === id);
  if (!section) {
    throw new Error(`Investment page is missing the required section: ${id}`);
  }
  return section;
};

const value = requireSection("what-youre-really-investing-in");
const includes = requireSection("every-session-includes");
const journey = requireSection("how-it-works-start-to-finish");
const pricing = requireSection("a-note-about-pricing");
const printed = requireSection("printed-photographs");
const timeline = requireSection("how-long-everything-takes");
const policies = requireSection("good-to-know-before-you-book");
const questions = requireSection("common-questions");

const faqItems = questions.items || [];
const journeyItems = journey.items || [];
const canonical = absoluteUrl(page.route);
const valueArch =
  value.image ||
  "/uploads/investment-lisa-photographing-outdoors-tricities.jpg";
const valuePrint =
  value.secondaryImage ||
  "/uploads/investment-lisa-reviewing-camera-black-white.jpg";
const finalImage =
  page.finalCta?.image ||
  "/uploads/investment-lisa-studio-portrait-camera.jpg";

const investmentSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${canonical}#service`,
      name: "Portrait Photography Sessions",
      provider: { "@id": `${siteOrigin}/#business` },
      areaServed: [
        { "@type": "City", name: "Richland" },
        { "@type": "City", name: "Kennewick" },
        { "@type": "City", name: "Pasco" },
      ],
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Photography Services",
        itemListElement: [
          ["Family Photography", "/family-photographer-tri-cities-wa/"],
          ["Senior Pictures", "/senior-photographer-tri-cities-wa/"],
          ["Newborn Photography", "/newborn-photographer-tri-cities-wa/"],
          ["Branding Photography", "/branding-photographer-tri-cities-wa/"],
          ["Professional Headshots", "/headshot-photographer-tri-cities-wa/"],
        ].map(([name, path]) => ({
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name,
            url: absoluteUrl(path),
          },
        })),
      },
    },
    {
      "@type": "HowTo",
      "@id": `${canonical}#how-to-book`,
      name: "How to book a photography session with It's A Keeper Photography",
      step: journeyItems.map((item, index) => ({
        "@type": "HowToStep",
        position: index + 1,
        name: item.heading?.replace(/^\d+\.\s*/, ""),
        text: item.detail,
      })),
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.heading,
        acceptedAnswer: {
          "@type": "Answer",
          text: (item.paragraphs || []).join(" "),
        },
      })),
    },
  ],
};

// CONTENT PENDING: número de imágenes / duración por paquete — Lisa envió el
// pricing por separado. Añadir una línea neutral por tipo de sesión, sin cifras
// de dinero, cuando Lisa apruebe el wording final.
---

<article
  class="investment-page"
  data-investment-page
  data-content-status={page.contentStatus}
  data-signature-device={page.signature}
>
  <EditorialHero
    pageKey="investment"
    titleId="investment-hero-title"
    heading={page.hero.heading}
    headingLines={["The Experience", "& Investment"]}
    scriptLine={page.hero.scriptLine || "the full experience"}
    intro={page.hero.intro}
    links={page.hero.links}
    backgroundImage={
      page.hero.image ||
      "/uploads/investment-lisa-camera-studio-richland.jpg"
    }
    backgroundAlt={
      page.hero.imageAlt ||
      "Lisa Weiss holding her camera in her Richland photography studio."
    }
    backgroundPosition="52% 48%"
    mobileBackgroundPosition="65% 48%"
    leftPrint={{
      src:
        page.hero.secondaryImage ||
        "/uploads/family-golden-hour-columbia-basin.jpg",
      objectPosition: "50% 48%",
    }}
    rightPrint={{
      src: "/uploads/newborn-portrait-with-mother-richland.jpg",
      objectPosition: "50% 43%",
    }}
    paperEdgeColor="var(--color-muted-olive)"
  />

  <section
    class="investment-value"
    aria-labelledby={`${value.id}-title`}
    data-investment-section="value"
  >
    <div class="investment-shell investment-value__inner">
      <div class="investment-value__media" data-line-target="value-media">
        <span
          class="investment-value__line"
          data-construction-line
          data-line-anchor="image"
          aria-hidden="true"
        ></span>

        <figure class="investment-value__arch" data-investment-photo="value-arch">
          <Picture
            src={valueArch}
            alt={value.imageAlt || ""}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 76vw, (max-width: 1050px) 42vw, 30vw"
            imgClass="photo--editorial"
          />
        </figure>

        <figure
          class="investment-print investment-value__print"
          data-investment-photo="value-print"
        >
          <span class="investment-tape" aria-hidden="true"></span>
          <Picture
            src={valuePrint}
            alt={value.secondaryImageAlt || ""}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 46vw, (max-width: 1050px) 25vw, 18vw"
            imgClass="photo--editorial"
          />
        </figure>
      </div>

      <div class="investment-value__copy">
        <span class="investment-eyebrow">Twenty years in</span>
        <h2 id={`${value.id}-title`}>{value.heading}</h2>
        <div class="investment-prose">
          {value.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section
    class="investment-includes"
    aria-labelledby={`${includes.id}-title`}
    data-investment-section="includes"
  >
    <div class="investment-shell investment-includes__inner">
      <header class="investment-includes__heading">
        <span class="investment-eyebrow">Care, from beginning to end</span>
        <h2 id={`${includes.id}-title`}>{includes.heading}</h2>
      </header>

      <ol class="investment-includes__ledger">
        {includes.items?.map((item, index) => (
          <li>
            <span class="investment-ledger-number">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div>
              <h3>{item.heading}</h3>
              <p>{item.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section
    class="investment-journey"
    aria-labelledby={`${journey.id}-title`}
    data-investment-section="journey"
  >
    <div class="investment-shell investment-journey__inner">
      <div class="investment-journey__lead">
        <h2 id={`${journey.id}-title`}>{journey.heading}</h2>

        <div class="investment-journey__media" aria-hidden="true">
          <figure class="investment-journey__arch">
            <Picture
              src="/uploads/family-with-baby-golden-hour-embrace-tricities.jpg"
              alt=""
              loading="lazy"
              decoding="async"
              responsiveSrcset
              sizes="(max-width: 767px) 68vw, (max-width: 1050px) 35vw, 25vw"
              imgClass="photo--editorial"
            />
          </figure>
          <figure class="investment-print investment-journey__print">
            <Picture
              src="/uploads/lisa-photographer-at-work-black-white.jpg"
              alt=""
              loading="lazy"
              decoding="async"
              responsiveSrcset
              sizes="(max-width: 767px) 42vw, (max-width: 1050px) 22vw, 15vw"
              imgClass="photo--editorial"
            />
          </figure>
        </div>
      </div>

      <ol class="investment-journey__steps">
        {journeyItems.map((item, index) => (
          <li>
            <span class="investment-journey__number">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div>
              <h3>{item.heading?.replace(/^\d+\.\s*/, "")}</h3>
              {item.detail && <p>{item.detail}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section
    class="investment-pricing"
    aria-labelledby={`${pricing.id}-title`}
    data-investment-section="pricing"
  >
    <div class="investment-shell investment-pricing__sheet">
      <header class="investment-pricing__lead">
        <h2 id={`${pricing.id}-title`}>{pricing.heading}</h2>
        <figure class="investment-print investment-pricing__portrait">
          <span class="investment-tape investment-tape--reverse" aria-hidden="true"></span>
          <Picture
            src={pricing.image || "/uploads/investment-lisa-studio-portrait-camera.jpg"}
            alt={pricing.imageAlt || ""}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 62vw, (max-width: 1050px) 34vw, 22vw"
            imgClass="photo--editorial"
          />
        </figure>
      </header>

      <div class="investment-pricing__copy">
        <div class="investment-prose">
          {pricing.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        {pricing.links?.[0] && (
          <a class="outline-button" href={pricing.links[0].href}>
            {pricing.links[0].label}
          </a>
        )}
        <p class="investment-pricing__note">
          A planning estimate — not a booking or contract
        </p>
      </div>
    </div>
  </section>

  <section
    class="investment-prints"
    aria-labelledby={`${printed.id}-title`}
    data-investment-section="prints"
  >
    <div class="investment-prints__copy">
      <div class="investment-prints__copy-inner">
        <h2 id={`${printed.id}-title`}>{printed.heading}</h2>
        <div class="investment-prints__columns">
          {printed.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        {printed.scriptLine && (
          <p class="investment-prints__script" aria-hidden="true">
            {printed.scriptLine}
          </p>
        )}
      </div>
    </div>

    <div class="investment-prints__media" aria-hidden="true">
      <span class="investment-prints__line" data-construction-line></span>
      <figure class="investment-print investment-prints__primary">
        <span class="investment-tape" aria-hidden="true"></span>
        <Picture
          src={printed.image || "/uploads/extended-family-embrace-tricities.jpg"}
          alt=""
          loading="lazy"
          decoding="async"
          responsiveSrcset
          sizes="(max-width: 767px) 72vw, (max-width: 1050px) 42vw, 33vw"
          imgClass="photo--editorial"
        />
      </figure>
      <figure class="investment-print investment-prints__secondary">
        <Picture
          src={printed.secondaryImage || "/uploads/family-children-golden-hour-tricities.jpg"}
          alt=""
          loading="lazy"
          decoding="async"
          responsiveSrcset
          sizes="(max-width: 767px) 42vw, (max-width: 1050px) 24vw, 17vw"
          imgClass="photo--editorial"
        />
      </figure>
      <figure class="investment-print investment-prints__album">
        <Picture
          src="/uploads/family-laughter-black-white-tricities.jpg"
          alt=""
          loading="lazy"
          decoding="async"
          responsiveSrcset
          sizes="(max-width: 767px) 58vw, (max-width: 1050px) 34vw, 26vw"
          imgClass="photo--editorial"
        />
      </figure>
    </div>
  </section>

  <section
    class="investment-timeline"
    aria-labelledby={`${timeline.id}-title`}
    data-investment-section="timeline"
  >
    <div class="investment-shell investment-timeline__inner">
      <header class="investment-timeline__heading">
        <h2 id={`${timeline.id}-title`}>{timeline.heading}</h2>
        {timeline.intro && <p>{timeline.intro}</p>}
      </header>

      <figure class="investment-print investment-timeline__photograph">
        <Picture
          src={timeline.image || "/uploads/investment-lisa-camera-black-white-wide.jpg"}
          alt={timeline.imageAlt || ""}
          loading="lazy"
          decoding="async"
          responsiveSrcset
          sizes="(max-width: 767px) 88vw, (max-width: 1050px) 62vw, 48vw"
          imgClass="photo--editorial"
        />
      </figure>

      <ol class="investment-timeline__ledger">
        {timeline.items?.map((item, index) => (
          <li>
            <span class="investment-timeline__number">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3>{item.heading}</h3>
            <p>{item.detail}</p>
          </li>
        ))}
      </ol>

      <aside class="investment-timeline__note">
        <span>Keep them safe</span>
        <div>
          {timeline.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </aside>
    </div>
  </section>

  <section
    class="investment-policies"
    aria-labelledby={`${policies.id}-title`}
    data-investment-section="policies"
  >
    <div class="investment-shell investment-policies__inner">
      <header>
        <h2 id={`${policies.id}-title`}>{policies.heading}</h2>
      </header>

      <ol class="investment-policies__ledger">
        {policies.items?.map((item, index) => (
          <li>
            <span class="investment-ledger-number">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div>
              <h3>{item.heading}</h3>
              <p>{item.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section
    class="investment-faq"
    aria-labelledby={`${questions.id}-title`}
    data-investment-section="faq"
  >
    <div class="investment-shell investment-faq__inner">
      <div class="investment-faq__questions">
        <header>
          <h2 id={`${questions.id}-title`}>{questions.heading}</h2>
        </header>

        <div class="investment-faq__ledger">
          {faqItems.map((item, index) => (
            <details open={index === 0}>
              <summary>
                <span class="investment-faq__number">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span>{item.heading}</span>
                <span class="investment-faq__mark" aria-hidden="true"></span>
              </summary>
              <div class="investment-faq__answer">
                {item.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </details>
          ))}
        </div>
      </div>

      {page.finalCta && (
        <aside class="investment-final" aria-labelledby="investment-final-title">
          <figure class="investment-print investment-final__portrait">
            <Picture
              src={finalImage}
              alt={page.finalCta.imageAlt || ""}
              loading="lazy"
              decoding="async"
              responsiveSrcset
              sizes="(max-width: 767px) 74vw, (max-width: 1050px) 34vw, 20vw"
              imgClass="photo--editorial"
            />
          </figure>

          <div class="investment-final__paper">
            <Picture
              src="/uploads/investment-final-torn-paper-pin.png"
              alt=""
              loading="lazy"
              decoding="async"
              responsiveSrcset
              sizes="(max-width: 767px) 82vw, (max-width: 1050px) 50vw, (max-width: 1250px) 34vw, 25vw"
              pictureClass="investment-final__paper-art-frame"
              imgClass="investment-final__paper-art"
            />
            <div class="investment-final__paper-content">
              <span class="investment-eyebrow">The next step</span>
              <h2 id="investment-final-title">{page.finalCta.heading}</h2>
              {page.finalCta.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
              {page.finalCta.link && (
                <a class="outline-button" href={page.finalCta.link.href}>
                  {page.finalCta.link.label}
                </a>
              )}
            </div>
          </div>
        </aside>
      )}
    </div>
  </section>

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(investmentSchema)}
  />
</article>
