---
import type {
  EditorialPageData,
  PageSection,
} from "../../content/page-types";
import Picture from "../Picture.astro";
import SessionPriceCalculator from "../SessionPriceCalculator.astro";
import EditorialHero from "./EditorialHero.astro";
import "../../styles/contact-page.css";

interface Props {
  page: EditorialPageData;
  settings: any;
  inquiry?: any;
}

const { page, settings } = Astro.props;

const requireSection = (id: string): PageSection => {
  const section = page.sections.find((candidate) => candidate.id === id);
  if (!section) throw new Error(`Contact page is missing the required section: ${id}`);
  return section;
};

requireSection("tell-me-about-you");
const next = requireSection("what-happens-after-you-reach-out");
const talk = requireSection("prefer-to-call-or-text");
const where = requireSection("where-i-work");

const notificationRecipient =
  import.meta.env.PUBLIC_INQUIRY_NOTIFICATION_EMAIL ||
  "itsakeeperphoto@gmail.com";
---

<article
  class="contact-page"
  data-content-status={page.contentStatus}
  data-signature-device={page.signature}
>
  <EditorialHero
    pageKey="contact"
    titleId="contact-hero-title"
    heading={page.hero.heading}
    headingLines={["Let's plan", "your session"]}
    scriptLine={page.hero.scriptLine || ""}
    intro={page.hero.intro}
    links={[{ label: "Build My Estimate", href: "#session-planner" }]}
    backgroundImage={page.hero.image || "/uploads/family-golden-hour-columbia-basin.jpg"}
    backgroundAlt={page.hero.imageAlt || "A family held close in warm golden-hour light in the Tri-Cities"}
    backgroundPosition="50% 50%"
    mobileBackgroundPosition="69% 50%"
    leftPrint={{
      src:
        page.hero.secondaryImage ||
        "/uploads/review-isabella-senior-golden-hour-tricities.jpg",
      objectPosition: "50% 54%",
    }}
    rightPrint={{
      src: "/uploads/newborn-portrait-with-mother-richland.jpg",
      objectPosition: "50% 46%",
    }}
    paperEdgeColor="var(--color-warm-ivory)"
  />

  <SessionPriceCalculator notificationRecipient={notificationRecipient} />

  <section
    class="contact-next"
    aria-labelledby="contact-next-title"
  >
    <div class="contact-shell">
      <header class="contact-next__header">
        <p class="section-eyebrow">After you press send</p>
        <h2 id="contact-next-title">{next.heading}</h2>
      </header>

      <ol class="contact-next__ledger">
        {next.items?.map((item, index) => (
          <li>
            <span>{String(index + 1).padStart(2, "0")}</span>
            {item.heading && <h3>{item.heading.replace(/^\d+\.\s*/, "")}</h3>}
            {item.detail && <p>{item.detail}</p>}
          </li>
        ))}
      </ol>

      {next.paragraphs?.map((paragraph) => (
        <p class="contact-next__note">{paragraph}</p>
      ))}
    </div>
  </section>

  <section
    class="contact-reassurance"
    aria-labelledby="contact-talk-title"
  >
    <div class="contact-shell contact-reassurance__inner">
      <div class="contact-reassurance__copy">
        <span class="contact-reassurance__rule" aria-hidden="true"></span>
        <p class="section-eyebrow">A real person on the other side</p>
        <h2 id="contact-talk-title">{talk.heading}</h2>
        <div class="contact-reassurance__prose">
          {talk.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="contact-reassurance__actions">
          <a class="outline-button" href="tel:+15099487322">
            Call or Text {settings.phone}
          </a>
          <a class="text-link" href={`mailto:${settings.email}`}>
            {settings.email}
          </a>
        </div>
      </div>

      <div class="contact-reassurance__media">
        <span class="contact-reassurance__construction" aria-hidden="true"></span>
        <figure class="contact-reassurance__arch">
          <Picture
            src="/uploads/lisa-photographer-tricities.jpg"
            alt="Lisa Weiss holding her camera"
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 78vw, (max-width: 1050px) 44vw, 28rem"
            imgClass="photo--editorial"
          />
        </figure>
        <div class="contact-reassurance__place">
          <p class="section-eyebrow">{where.heading}</p>
          {where.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </section>
</article>
