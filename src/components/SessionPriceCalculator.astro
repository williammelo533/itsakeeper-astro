---
import Picture from "./Picture.astro";
import {
  EXTRA_PERSON_PRICE_CENTS,
  MAX_PEOPLE,
  MIN_PEOPLE,
  PEOPLE_INCLUDED,
  PHOTO_COLLECTIONS,
  SESSION_ADD_ONS,
  SESSION_PACKAGES,
  SESSION_SERVICES,
  formatUsd,
} from "../lib/session-pricing";

interface Props {
  notificationRecipient?: string;
}

const {
  notificationRecipient =
    import.meta.env.PUBLIC_INQUIRY_NOTIFICATION_EMAIL ||
    "itsakeeperphoto@gmail.com",
} = Astro.props;

const services = Object.values(SESSION_SERVICES);
const packages = Object.values(SESSION_PACKAGES);
const collections = Object.values(PHOTO_COLLECTIONS);
const addOns = Object.values(SESSION_ADD_ONS);
const initialService = services[0];
const initialPackage = packages[0];
const pricingVersion = "2026-07-29";
---

<section
  class="session-planner"
  id="session-planner"
  aria-labelledby="session-planner-title"
  data-session-planner
>
  <div class="contact-shell">
    <header class="session-planner__header">
      <p class="section-eyebrow">A clear place to begin</p>
      <h2 id="session-planner-title">Build Your Session Estimate</h2>
      <p>
        Choose what fits the session you have in mind. Your estimate updates as
        you go, then Lisa follows up personally to confirm the details.
      </p>
    </header>

    <nav class="planner-progress" aria-label="Estimate planner sections">
      <ol>
        <li>
          <button
            type="button"
            aria-current="step"
            data-planner-progress="session"
            data-scroll-target="planner-session"
          >
            <span>01</span>
            <small>Session</small>
          </button>
        </li>
        <li>
          <button
            type="button"
            data-planner-progress="coverage"
            data-scroll-target="planner-coverage"
          >
            <span>02</span>
            <small>Coverage</small>
          </button>
        </li>
        <li>
          <button
            type="button"
            data-planner-progress="keepsakes"
            data-scroll-target="planner-keepsakes"
          >
            <span>03</span>
            <small>Keepsakes</small>
          </button>
        </li>
        <li>
          <button
            type="button"
            data-planner-progress="details"
            data-scroll-target="planner-details"
          >
            <span>04</span>
            <small>Details</small>
          </button>
        </li>
      </ol>
    </nav>

    <form
      class="session-planner__form"
      name="session-estimate"
      method="post"
      action="/thank-you/"
      data-netlify="true"
      netlify-honeypot="bot-field"
      data-session-estimate-form
    >
      <input type="hidden" name="form-name" value="session-estimate" />
      <p class="sr-only" aria-hidden="true">
        <label>
          Leave this field empty:
          <input name="bot-field" tabindex="-1" autocomplete="off" />
        </label>
      </p>

      <input
        type="hidden"
        name="notification_recipient"
        value={notificationRecipient}
      />
      <input type="hidden" name="pricing_version" value={pricingVersion} />
      <input
        type="hidden"
        name="package_name"
        value=""
        data-estimate-field="package_name"
      />
      <input
        type="hidden"
        name="package_price"
        value=""
        data-estimate-field="package_price"
      />
      <input
        type="hidden"
        name="extra_people_fee"
        value=""
        data-estimate-field="extra_people_fee"
      />
      <input
        type="hidden"
        name="collection_name"
        value=""
        data-estimate-field="collection_name"
      />
      <input
        type="hidden"
        name="collection_price"
        value=""
        data-estimate-field="collection_price"
      />
      <input
        type="hidden"
        name="selected_addons"
        value=""
        data-estimate-field="selected_addons"
      />
      <input
        type="hidden"
        name="addon_total"
        value=""
        data-estimate-field="addon_total"
      />
      <input
        type="hidden"
        name="estimated_total"
        value=""
        data-estimate-field="estimated_total"
      />
      <input
        type="hidden"
        name="estimate_breakdown"
        value="Recalculate from the raw selections; live JavaScript calculation was unavailable."
        data-estimate-field="estimate_breakdown"
      />
      <input
        type="hidden"
        name="calculation_status"
        value="Requires manual calculation"
        data-estimate-field="calculation_status"
      />

      <div class="session-planner__workspace">
        <div class="session-planner__choices">
          <fieldset
            class="planner-phase planner-phase--session"
            id="planner-session"
            data-planner-phase="session"
          >
            <legend>
              <span class="planner-phase__number">01 · Your session</span>
              <span class="planner-phase__title">Who's in front of the camera?</span>
            </legend>
            <p class="planner-phase__intro">
              Start with the kind of story you're here to keep.
            </p>

            <div
              class="service-contact-sheet"
              role="radiogroup"
              aria-label="Session type"
            >
              {services.map((service, index) => (
                <label class="service-print">
                  <input
                    type="radio"
                    name="session_type"
                    value={service.id}
                    required
                    checked={index === 0 || undefined}
                    data-service-radio
                    data-service-name={service.name}
                    data-service-image={service.image}
                    data-next-target="planner-coverage"
                  />
                  <span class="service-print__paper">
                    <span class="service-print__corners" aria-hidden="true"></span>
                    <span class="service-print__image">
                      <Picture
                        src={service.image}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        optimizedMobileWidth={400}
                        optimizedDesktopWidth={640}
                      />
                    </span>
                    <span class="service-print__label">{service.name}</span>
                    <span class="service-print__check" aria-hidden="true">✓</span>
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset
            class="planner-phase planner-phase--coverage"
            id="planner-coverage"
            data-planner-phase="coverage"
          >
            <legend>
              <span class="planner-phase__number">02 · Coverage</span>
              <span class="planner-phase__title">Choose the time we'll have together</span>
            </legend>
            <p class="planner-phase__intro">
              Every package includes up to {PEOPLE_INCLUDED} people. The session
              structure applies to seniors, families, newborns, branding and
              headshots.
            </p>

            <div class="package-ledger">
              {packages.map((sessionPackage, index) => (
                <label class="package-row">
                  <input
                    type="radio"
                    name="session_package"
                    value={sessionPackage.id}
                    required
                    checked={index === 0 || undefined}
                    data-package-radio
                    data-next-target="planner-people"
                  />
                  <span class="package-row__marker" aria-hidden="true"></span>
                  <span class="package-row__identity">
                    <strong>{sessionPackage.name}</strong>
                    <small>Session package</small>
                  </span>
                  <span class="package-row__coverage">
                    <span>{sessionPackage.duration}</span>
                    <span>{sessionPackage.locations}</span>
                    <span>{sessionPackage.outfits}</span>
                  </span>
                  <span class="package-row__price">
                    {formatUsd(sessionPackage.priceCents)}
                  </span>
                </label>
              ))}
            </div>

            <div class="people-control" id="planner-people">
              <div>
                <span class="people-control__label">People in the session</span>
                <p>
                  Five are included; each additional person adds
                  {formatUsd(EXTRA_PERSON_PRICE_CENTS)}.
                </p>
              </div>
              <div
                class="people-stepper"
                role="group"
                aria-label="Number of people"
              >
                <button
                  type="button"
                  aria-label="Remove one person"
                  data-people-decrease
                  disabled
                >
                  −
                </button>
                <input
                  type="number"
                  name="people"
                  value={MIN_PEOPLE}
                  min={MIN_PEOPLE}
                  max={MAX_PEOPLE}
                  inputmode="numeric"
                  aria-label="Number of people"
                  data-people-input
                />
                <button
                  type="button"
                  aria-label="Add one person"
                  data-people-increase
                >
                  +
                </button>
              </div>
              <p class="people-control__status" aria-live="polite" data-people-status>
                Up to {PEOPLE_INCLUDED} people are included.
              </p>
            </div>
          </fieldset>

          <fieldset
            class="planner-phase planner-phase--keepsakes"
            id="planner-keepsakes"
            data-planner-phase="keepsakes"
          >
            <legend>
              <span class="planner-phase__number">03 · Keepsakes</span>
              <span class="planner-phase__title">Choose how you'd like to keep it</span>
            </legend>
            <p class="planner-phase__intro">
              Add a collection now, or choose none and talk through it with Lisa
              later.
            </p>

            <div class="collection-ledger">
              {collections.map((collection, index) => (
                <label class="collection-row">
                  <input
                    type="radio"
                    name="collection"
                    value={collection.id}
                    required
                    checked={index === 0 || undefined}
                    data-collection-radio
                    data-next-target="planner-add-ons"
                  />
                  <span class="collection-row__marker" aria-hidden="true"></span>
                  <span class="collection-row__copy">
                    <strong>
                      {collection.id === "none"
                        ? "No collection yet"
                        : `Collection ${collection.name}`}
                    </strong>
                    <span>
                      {collection.details.length > 0
                        ? collection.details.join(" · ")
                        : "Session coverage only — decide on keepsakes later."}
                    </span>
                  </span>
                  <span class="collection-row__price">
                    {collection.priceCents > 0
                      ? formatUsd(collection.priceCents)
                      : "No add"}
                  </span>
                </label>
              ))}
            </div>

            <div
              class="add-on-group"
              id="planner-add-ons"
              aria-labelledby="add-on-title"
            >
              <div class="add-on-group__heading">
                <h3 id="add-on-title">Optional finishing touches</h3>
                <p>These prices are confirmed and included in the live estimate.</p>
              </div>
              <div class="add-on-list">
                {addOns.map((addOn) => (
                  <label class="add-on-row">
                    <input
                      type="checkbox"
                      name="addons"
                      value={addOn.id}
                      data-addon-checkbox
                    />
                    <span class="add-on-row__box" aria-hidden="true">✓</span>
                    <span>{addOn.name}</span>
                    <strong>{formatUsd(addOn.priceCents)}</strong>
                  </label>
                ))}
              </div>
            </div>
          </fieldset>

          <fieldset
            class="planner-phase planner-phase--details"
            id="planner-details"
            data-planner-phase="details"
          >
            <legend>
              <span class="planner-phase__number">04 · Review &amp; send</span>
              <span class="planner-phase__title">Tell Lisa where to reach you</span>
            </legend>
            <p class="planner-phase__intro">
              This sends your complete estimate and notes to Lisa. It does not
              reserve a date or charge a payment.
            </p>

            <div class="planner-contact-fields">
              <label>
                <span>Your name</span>
                <input
                  type="text"
                  name="name"
                  autocomplete="name"
                  required
                  data-contact-field
                />
              </label>
              <label>
                <span>Email</span>
                <input
                  type="email"
                  name="email"
                  autocomplete="email"
                  required
                  data-contact-field
                />
              </label>
              <label>
                <span>Phone</span>
                <input
                  type="tel"
                  name="phone"
                  autocomplete="tel"
                  inputmode="tel"
                  required
                  data-contact-field
                />
              </label>
              <label>
                <span>Preferred timing</span>
                <input
                  type="text"
                  name="preferred_timing"
                  autocomplete="off"
                  placeholder="Season, month, or I'm flexible"
                  data-contact-field
                />
              </label>
              <label class="planner-contact-fields__story">
                <span>What are you hoping to keep?</span>
                <textarea
                  name="story"
                  rows="6"
                  required
                  placeholder="Tell Lisa who these photographs are for, what matters to you, and anything she should know."
                  data-contact-field
                ></textarea>
              </label>
            </div>

            <div class="planner-submit">
              <p>
                Estimate only. Lisa will confirm the final details, send the
                contract and payment link, and reserve the date after the
                contract and retainer are complete.
              </p>
              <button class="outline-button" type="submit" data-estimate-submit>
                Send My Estimate to Lisa
              </button>
            </div>
          </fieldset>

          <noscript>
            <p class="planner-noscript">
              The form is fully submittable without JavaScript. The receipt
              will not update live, but your raw selections are sent so Lisa
              can calculate and verify the estimate before booking.
            </p>
          </noscript>
        </div>

        <aside
          class="estimate-receipt"
          id="estimate-receipt"
          aria-labelledby="estimate-receipt-title"
          data-estimate-receipt
        >
          <img
            class="estimate-receipt__clip"
            src="/uploads/bronze-paper-clip.png"
            width="192"
            height="161"
            alt=""
            aria-hidden="true"
          />
          <div class="estimate-receipt__photo">
            <img
              src={initialService.image}
              width="800"
              height="1000"
              alt={`${initialService.name} photography session preview`}
              loading="lazy"
              decoding="async"
              data-receipt-image
            />
          </div>
          <p class="section-eyebrow">Live session receipt</p>
          <h3 id="estimate-receipt-title">Your Estimate</h3>
          <dl class="estimate-receipt__lines">
            <div>
              <dt>Session</dt>
              <dd data-receipt-service>{initialService.name}</dd>
            </div>
            <div>
              <dt>Coverage</dt>
              <dd data-receipt-package>
                {initialPackage.name} · {formatUsd(initialPackage.priceCents)}
              </dd>
            </div>
            <div>
              <dt>People</dt>
              <dd data-receipt-people>{MIN_PEOPLE} · Included</dd>
            </div>
            <div>
              <dt>Keepsakes</dt>
              <dd data-receipt-collection>No collection yet</dd>
            </div>
            <div>
              <dt>Add-ons</dt>
              <dd data-receipt-addons>None</dd>
            </div>
          </dl>
          <div class="estimate-receipt__total">
            <span>Estimated total</span>
            <strong data-estimate-total>
              {formatUsd(initialPackage.priceCents)}
            </strong>
          </div>
          <p class="estimate-receipt__note">
            A planning estimate, not a booking. Lisa confirms everything with
            you before a contract or payment.
          </p>
          <p class="sr-only" aria-live="polite" aria-atomic="true" data-total-live>
            Estimated total {formatUsd(initialPackage.priceCents)}.
          </p>
        </aside>
      </div>
    </form>
  </div>

  <div class="mobile-estimate-bar" data-mobile-estimate-bar>
    <span>
      <small>Estimated total</small>
      <strong data-mobile-estimate-total>
        {formatUsd(initialPackage.priceCents)}
      </strong>
    </span>
    <button type="button" data-review-estimate>Review estimate</button>
  </div>
</section>

<script>
  import { initSessionPriceCalculators } from "../scripts/session-price-calculator";

  initSessionPriceCalculators();
</script>
